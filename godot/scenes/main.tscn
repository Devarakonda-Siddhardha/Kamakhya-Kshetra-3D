script = ExtResource("3_hotspot")
site_id = "torana"
title = "Western Stone Torana"
subtitle = "Pilgrim Gateway & Temple Bells"
description = "Carved granite gateway marking entry into the inner Kamakhya courtyard. Pilgrims ring the suspended brass bells as they ascend from the Nilachal hillside steps."

[node name="Shape" type="CollisionShape3D" parent="Landmarks/ToranaHotspot"]
