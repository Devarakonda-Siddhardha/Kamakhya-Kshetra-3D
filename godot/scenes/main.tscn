[node name="GarbhagrihaHotspot" type="Area3D" parent="Landmarks"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 9, 1.5, -5.5)
script = ExtResource("3_hotspot")
site_id = "garbhagriha"
title = "Garbhagriha — Nilachala Shikhara"
subtitle = "Heart of Kamakhya Shakti Peetha"
description = "Rebuilt in 1565 by Koch King Nara Narayana, the Garbhagriha defines the Nilachala architectural style: a cruciform carved stone bada crowned by a bulbous ribbed beehive brick dome, ringed by twelve angashikharas and a golden kalasha with trishul. Within lies a natural rock fissure fed by an underground spring."

[node name="Shape" type="CollisionShape3D" parent="Landmarks/GarbhagrihaHotspot"]
shape = SubResource("HotspotSphere_1")

[node name="CalantaHotspot" type="Area3D" parent="Landmarks"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, 1.5, -5.5)
script = ExtResource("3_hotspot")
site_id = "calanta"
title = "Calanta (Twelve-Pillared Hall)"
subtitle = "Passage Between Sanctum & Saubhagya Kunda"
description = "Resting on twelve carved stone pillars, the Calanta houses the movable utsava image of Devi Kameshwari and royal stone inscriptions of King Nara Narayana and Chilarai. Its northern doorway opens directly toward the sacred Saubhagya Kunda."

[node name="Shape" type="CollisionShape3D" parent="Landmarks/CalantaHotspot"]
shape = SubResource("HotspotSphere_1")

[node name="PancharatnaHotspot" type="Area3D" parent="Landmarks"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5.2, 1.5, -5.5)
script = ExtResource("3_hotspot")
site_id = "pancharatna"
title = "Pancharatna Mandapa"
subtitle = "Five-Domed Ritual Chamber"
description = "Crowned by four corner Nilachala domes flanking a larger central dome, the Pancharatna connects the Calanta to the western Natamandira and hosts devotional chants and temple rituals."

[node name="Shape" type="CollisionShape3D" parent="Landmarks/PancharatnaHotspot"]
shape = SubResource("HotspotSphere_1")

[node name="NatamandiraHotspot" type="Area3D" parent="Landmarks"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -14.5, 1.5, -5.5)
script = ExtResource("3_hotspot")
site_id = "natamandira"
title = "Natamandira"
subtitle = "Apsidal Hall of Sacred Music & Dance"
description = "Added during the Ahom period, the western Natamandira features a sweeping curved apsidal roof and wide arched portals where traditional music and temple dances are performed."

[node name="Shape" type="CollisionShape3D" parent="Landmarks/NatamandiraHotspot"]
shape = SubResource("HotspotSphere_1")

[node name="SaubhagyaKundaHotspot" type="Area3D" parent="Landmarks"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2, 1.5, -15.5)
script = ExtResource("3_hotspot")
site_id = "saubhagya_kunda"
title = "Saubhagya Kunda"
subtitle = "Sacred Stepped Tank of Fortune"
description = "Located immediately north of the main temple courtyard, this rectangular stepped stone tank reflects the terracotta shikhara and golden kalasha. Devotees light earthen diyas along its steps during dusk aarti and Ambubachi Mela."

[node name="Shape" type="CollisionShape3D" parent="Landmarks/SaubhagyaKundaHotspot"]
