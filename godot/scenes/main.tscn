[node name="TaraHotspot" type="Area3D" parent="Landmarks"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -18, 1.5, 14)
script = ExtResource("3_hotspot")
site_id = "tara_shrine"
title = "Dasamahavidya Shrines & Nilachal Hill"
subtitle = "Sacred Landscape of Ten Wisdom Goddesses"
description = "Kamakhya Kshetra encompasses the entire Nilachal Hill (Brahma, Shiva, and Varaha hills), home to the Ten Mahavidyas (Tara, Kali, Bhuvaneshwari, Bhairavi, Chinnamasta, Dhumavati, Bagalamukhi) and the Pancha Shiva shrines overlooking the Brahmaputra River."

